<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Executor third-party licenses</title>
  </head>
  <body>
    <h1>Executor third-party licenses</h1>
    <ul>
      {{#each overview}}
        <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
      {{/each}}
    </ul>
    {{#each licenses}}
      <section id="{{id}}">
        <h2>{{name}}</h2>
        <p>Used by:</p>
        <ul>
          {{#each used_by}}
            <li>{{crate.name}} {{crate.version}}</li>
          {{/each}}
        </ul>
        <pre>{{text}}</pre>
      </section>
    {{/each}}
  </body>
</html>